# Surveyor GeoServices — produção segura
NODE_ENV=production
CORS_ORIGINS=https://surveyorr.com.br,https://www.surveyorr.com.br,https://admin.surveyorr.com.br
ENABLE_LEGACY_CORS_ORIGINS=false

# Nunca habilite estes fallbacks em produção sem necessidade operacional documentada.
GEOSERVICES_INEMA_TRY_HTTPS=true
GEOSERVICES_ALLOW_INSECURE_INEMA_HTTP=false
GEOSERVICES_ALLOW_INSECURE_INEMA_TLS=false
GEOSERVICES_MAX_REDIRECTS=4
GEOSERVICES_TIMEOUT_MS=8500
GEOSERVICES_MAX_RESPONSE_BYTES=26214400
GEOSERVICES_ALLOWED_HOSTS=geoserver.inema.ba.gov.br,inema.ba.gov.br

APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=surveyor-georural-pro
APPWRITE_DATABASE_ID=surveyor_db
APPWRITE_API_KEY=COLE_A_CHAVE_SERVER_AQUI
APPWRITE_COLLECTION_LAYERS=layers
APPWRITE_BUCKET_PROJECT_FILES=project_files
GEOSERVICES_INTERNAL_TOKEN=troque_por_um_token_grande_e_igual_na_surveyor_api
LAYER_IMPORT_MAX_ZIP_BYTES=1073741824
LAYER_IMPORT_TILE_ZOOM=12
LAYER_IMPORT_MAX_FEATURES_PER_TILE=6000
