# Surveyor Save Function 2.0.0 — exemplo. NÃO coloque segredos reais no Git.
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=surveyor-georural-pro
APPWRITE_DATABASE_ID=surveyor_db

# Chave exclusiva da Function de salvar. Use o menor conjunto de scopes possível.
SURVEYOR_SAVE_APPWRITE_API_KEY=COLE_A_CHAVE_APENAS_NAS_VARIAVEIS_DA_FUNCTION
ALLOW_DYNAMIC_APPWRITE_KEY=false

# A Save Function valida o JWT localmente, sem consultar /api/auth/me a cada salvamento.
# Deve ser o MESMO JWT_SECRET da Surveyor API principal.
JWT_SECRET=troque_pelo_mesmo_jwt_secret_da_api_principal
APPWRITE_UPSTREAM_TIMEOUT_MS=15000

APPWRITE_COLLECTION_PROJECTS=projects
APPWRITE_COLLECTION_DOCUMENTS=documents
APPWRITE_BUCKET_PROJECT_FILES=project_files
PROJECT_VERSION_RETENTION=20

# Criptografia de aplicação Surveyor v1 — use a MESMA DATA KEY configurada na API principal.
SURVEYOR_CRYPTO_ACTIVE_KEY=v1
SURVEYOR_DATA_KEY_V1=
SURVEYOR_CRYPTO_REQUIRED=false
SURVEYOR_CRYPTO_ALLOW_LEGACY_READ=true

# Limites defensivos
MAX_SAVE_BODY_BYTES=12582912
MAX_PROJECT_FEATURES=25000
MAX_PROJECT_VERTICES_TOTAL=250000
MAX_PROJECT_VERTICES_PER_RING=2000
MAX_PROJECT_VERTICES_PER_LINE=10000

# Origens do frontend
CORS_ORIGINS=https://surveyorr.com.br,https://www.surveyorr.com.br
ENABLE_LEGACY_CORS_ORIGINS=false
# true apenas enquanto precisar testar via localhost/127.0.0.1. Em produção comercial, prefira false.
ALLOW_LOCAL_DEV_ORIGINS=false
