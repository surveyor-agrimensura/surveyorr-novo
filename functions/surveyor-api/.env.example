# Appwrite Function - Surveyor API
# Configure estas variáveis dentro da Function no painel do Appwrite.

DATA_PROVIDER=appwrite
NODE_ENV=production

APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=surveyor-georural-pro
APPWRITE_DATABASE_ID=surveyor_db
APPWRITE_API_KEY=COLE_A_CHAVE_SERVER_AQUI

APPWRITE_COLLECTION_PROJECTS=projects
APPWRITE_COLLECTION_FOLDERS=folders
APPWRITE_COLLECTION_DOCUMENTS=documents
APPWRITE_COLLECTION_CUSTOMIZATION=customization
APPWRITE_COLLECTION_USERS_PROFILE=users_profile
APPWRITE_COLLECTION_PLANS=plans
APPWRITE_COLLECTION_WORKSPACE_MEMBERS=workspace_members

APPWRITE_BUCKET_PROJECT_FILES=project_files
APPWRITE_BUCKET_GENERATED_DOCUMENTS=generated_documents
APPWRITE_BUCKET_USER_ASSETS=user_assets

JWT_SECRET=troque_por_um_segredo_grande_com_32_caracteres_ou_mais
# Segredo independente usado para emitir tokens curtos do Worker GeoServices.
BOOTSTRAP_SECRET=troque_por_outro_segredo_grande_com_32_caracteres_ou_mais
ENABLE_BOOTSTRAP_ROUTES=false
CORS_ORIGINS=https://surveyorr.com.br,https://www.surveyorr.com.br,https://admin.surveyorr.com.br,https://pagamento.surveyorr.com.br,https://loja.surveyorr.com.br
ALLOW_LEGACY_AUTH_HEADERS=false
ENABLE_LEGACY_CORS_ORIGINS=false
ALLOW_LOCAL_DEV_ORIGINS=false # localhost:5500 já é aceito; true libera outras portas locais

# Criptografia de aplicação Surveyor v1 — nunca coloque chaves reais no Git.
# Gere DATA e BLIND INDEX como valores aleatórios independentes de 32 bytes (Base64).
SURVEYOR_CRYPTO_ACTIVE_KEY=v1
SURVEYOR_DATA_KEY_V1=
SURVEYOR_BLIND_INDEX_KEY_V1=
# Durante a transição: false. Após migrar e homologar todos os registros: true.
SURVEYOR_CRYPTO_REQUIRED=false
# Permite ler projetos antigos em plaintext durante a migração. Depois da migração pode virar false.
SURVEYOR_CRYPTO_ALLOW_LEGACY_READ=true

# Hardening v21.11.1
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_FAIL_OPEN=false
SHARE_RATE_LIMIT_FAIL_OPEN=false
ADMIN_AI_INCLUDE_PII=false
CUSTOMIZATION_LOGO_MAX_BYTES=1572864
CUSTOMIZATION_SIGNATURE_MAX_BYTES=2097152
CUSTOMIZATION_TEMPLATE_MAX_CHARS=8388608
GEOMETRY_MAX_INTERSECTION_CHECK_SEGMENTS=3000
PROJECT_MAX_FEATURES=25000
PROJECT_MAX_VERTICES_TOTAL=250000
PROJECT_MAX_VERTICES_PER_RING=2000
PROJECT_MAX_VERTICES_PER_LINE=10000

# Renovação por suporte e bloqueio automático do plano.
# O aviso aparece no sino quando faltam 7 dias. A promoção fica válida por 2 dias
# a partir do primeiro aviso, limitada à data de vencimento.
RENEWAL_EARLY_WARNING_DAYS=7
RENEWAL_PROMO_WINDOW_DAYS=2
RENEWAL_ANNUAL_DISCOUNT_PERCENT=30


# Integração com Function surveyor-geoservices para processamento SHP/ZIP
GEOSERVICES_FUNCTION_URL=https://SUA_FUNCTION_SURVEYOR_GEOSERVICES.appwrite.run
GEOSERVICES_INTERNAL_TOKEN=troque_por_um_token_grande_e_igual_nas_duas_functions
LAYER_SOURCE_UPLOAD_MAX_BYTES=67108864
LAYER_VIEWPORT_MAX_TILES=160
LAYER_VIEWPORT_MAX_FEATURES=12000


# Use uma destas integrações para envio real:
# 
# 
#

# Google Drive Storage — Minha Nuvem
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://api.surveyorr.com.br/api/integrations/google-drive/callback
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Surveyor Storage
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_UPLOAD_MAX_BYTES=1073741824

# v2.19.380 — envio de documentos dos planos
# EMAIL_FUNCTION_URL=https://SEU-ENDPOINT-DA-FUNCTION-DE-SUPORTE
# EMAIL_FUNCTION_SECRET=SEGREDO_INTERNO_IGUAL_NAS_DUAS_FUNCTIONS
EMAIL_FUNCTION_PLAN_DOCUMENT_PATH=/api/admin/send-plan-document
PLAN_DOCUMENT_MAX_ATTACHMENT_BYTES=8388608
SURVEYOR_LOGIN_URL=https://surveyorr.com.br/login/

# Equipes compartilhadas v2.19.414
EMAIL_FUNCTION_SUBUSER_PATH=/api/admin/send-subuser-welcome
EMAIL_FUNCTION_ACCOUNT_EMAIL_CHANGED_PATH=/api/admin/send-account-email-changed


# Segredo compartilhado apenas entre pagamento.surveyorr.com.br e esta Function.
# Aceito em X-Surveyor-Payment-Secret ou Authorization: Bearer.
PAYMENT_INTERNAL_SECRET=gere_um_segredo_aleatorio_com_mais_de_32_caracteres
# Produção comercial: exige preço integral do plano anual por padrão.
# Cupons/descontos só podem alterar o valor quando o payload os declarar explicitamente e passar pelas validações server-side.
PAYMENT_REQUIRE_FULL_PRICE=true
# Em produção comercial mantenha false. Habilite sandbox somente em ambiente isolado de testes.
PAYMENT_ALLOW_SANDBOX=false
# Protege a conta administrativa contra testes de checkout acidentais.
ALLOW_PAYMENT_PROVISION_ADMIN=false
SURVEYOR_LOGIN_URL=https://surveyorr.com.br/login/

# Assistente IA exclusivo do painel administrativo
# A chave permanece somente na Function. O ditado por voz usa o navegador e não envia áudio à API.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=50000
ADMIN_AI_MAX_IMAGE_BYTES=2097152

# Telefone do painel e apenas contato; mantenha false para evitar colisao de targets no Auth.
SYNC_CONTACT_PHONE_TO_APPWRITE_AUTH=false
