# Appwrite Function - Surveyor Support
# Function separada da API principal.

NODE_ENV=production
SUPPORT_EMAIL=suporte@surveyorr.com.br
SUPPORT_FROM_EMAIL=suporte@surveyorr.com.br
SUPPORT_FROM_NAME=Surveyor Suporte

# Provedor recomendado:
BREVO_API_KEY=SUA_CHAVE_BREVO_AQUI

# Alternativas opcionais:
# RESEND_API_KEY=SUA_CHAVE_RESEND_AQUI
# SUPPORT_WEBHOOK_URL=https://seu-webhook.example.com/suporte
# SUPPORT_WEBHOOK_TOKEN=token_opcional

# CORS permitido. Inclua seu domínio publicado.
CORS_ORIGINS=https://surveyorr.com.br,https://www.surveyorr.com.br,https://admin.surveyorr.com.br
ENABLE_LEGACY_CORS_ORIGINS=false
ALLOW_LOCAL_DEV_ORIGINS=false

# Controle básico antiabuso
MAX_DETAILS_LENGTH=8000
MIN_FEATURE_DETAILS_LENGTH=30

# Envio de código de verificação de login
BREVO_SENDER_NAME=Surveyor Segurança
BREVO_SENDER_EMAIL=suporte@surveyorr.com.br
EMAIL_FUNCTION_SECRET=troque_por_um_segredo_interno_forte

# v1.0.11 — onboarding, anexos PDF e CORS restrito
PLAN_DOCUMENT_MAX_ATTACHMENT_BYTES=8388608
# EMAIL_FUNCTION_SECRET deve ser igual ao configurado na surveyor-api.

SURVEYOR_LOGIN_URL=https://surveyorr.com.br/login/
