# Cloudflare Pages: headers aplicados a todas as respostas do site.
# Referência: https://developers.cloudflare.com/pages/configuration/headers/
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Strict-Transport-Security: max-age=31536000
  # CSP em modo RELATÓRIO: não bloqueia nada. Navegue por todas as telas (mapa, croqui,
  # memorial, prancha, impressão, PDF) com o console aberto e corrija as violações
  # listadas. Só então troque o nome do header para Content-Security-Policy.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.surveyorr.com.br https://*.appwrite.run https://*.appwrite.io https://*.workers.dev https://servicodados.ibge.gov.br https://api.open-meteo.com https://nominatim.openstreetmap.org https://cdn.jsdelivr.net https://*.gov.br; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Arquivos versionados pelo Vite podem ficar no cache HTTP por longo prazo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O documento principal e o Service Worker devem sempre revalidar.
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, max-age=0, must-revalidate
