# Modo dev é local por padrão: sem endpoints, nenhum backend remoto é usado.
# Para dev local com APIs locais, descomente/ajuste URLs localhost.
VITE_SURVEYOR_ENV=local
# VITE_SURVEYOR_API_URL=http://localhost:3000
# VITE_SURVEYOR_SAVE_API_URL=http://localhost:3001
# VITE_SURVEYOR_SUPPORT_API_URL=http://localhost:3002
# VITE_GEOSERVICES_URL=http://localhost:3003

# Exceção consciente para apontar local para endpoints remotos:
# VITE_SURVEYOR_ALLOW_REMOTE_LOCAL=true

# Staging exige VITE_SURVEYOR_ENV=staging e todas as quatro URLs acima.
# Production usa endpoints padrão; sobrescreva apenas com URLs públicas aprovadas.
# Segredos nunca devem usar prefixo VITE_ nem ser incluídos no frontend.
