{
  "name": "surveyor-web",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5501",
    "typecheck": "tsc -b",
    "verify": "npm run test:functions && npm run check:release",
    "test": "vitest run",
    "test:offline": "node tools/offline-tests/selftest.mjs && node tools/offline-tests/run.mjs",
    "test:smoke": "node tests/smoke-publish.cjs",
    "check:release": "npm run test:deploy && npm run test:smoke && npm run test:zoom && npm run test:zoom-overlays && npm run test:mini-map && npm run test:prancha:gleba && npm run test:map-name:multi && npm run test:performance && npm run test && npm run test:stability && npm run build",
    "test:functions": "node --check functions/surveyor-api/src/main.js && node --check functions/surveyor-save/src/main.js && node --check functions/surveyor-support/src/main.js && node --check functions/surveyor-geoservices/src/main.js",
    "test:deploy": "node scripts/verify-deploy.mjs",
    "test:stability": "node tests/regression-estabilidade72.cjs && node tests/regression-integracao73.cjs && node tests/regression-integridade74.cjs && node tests/regression-paridade75.cjs && npm run test:customization-storage && npm run test:croqui-export && npm run test:scoped-drafts",
    "test:zoom": "node tests/croquiZoomFit.node.cjs",
    "test:customization-storage": "node tests/customizationBlobStorage.node.cjs",
    "test:croqui-export": "node tests/croquiCustomization.node.cjs",
    "test:appwrite-sync": "node tests/appwriteCustomizationIntegration.node.mjs",
    "test:performance": "node tests/performance.node.cjs",
    "test:maps:etapa13": "node tests/etapa13-mapas.node.cjs",
    "test:bloco1": "node tests/bloco1-deduplicacao.node.cjs",
    "test:bloco2": "node tests/bloco2-backend.node.mjs",
    "test:prancha:gleba": "node tests/pranchaGlebaIndividual.node.cjs",
    "test:scoped-drafts": "node tests/scopedDraftSync.node.mjs",
    "test:map-name:multi": "node tests/mapNameMultiGleba.node.cjs",
    "test:mini-map": "node tests/croquiServidoesMiniZoom.node.cjs",
    "test:confrontantes": "node --experimental-strip-types tests/confrontantPath.node.mjs",
    "test:zoom-overlays": "node tests/zoomCartographicSync.node.cjs"
  },
  "dependencies": {
    "@tomickigrzegorz/leaflet-rotate": "0.3.0",
    "konva": "^10.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "polygon-clipping": "^0.15.7",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "read-excel-file": "^9.3.12",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
