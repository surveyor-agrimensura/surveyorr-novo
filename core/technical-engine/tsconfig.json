{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "declaration": false,
    "sourceMap": false,
    "removeComments": false
  },
  "include": ["./src/**/*.ts"]
}
